---
import MainLayout from '../layouts/Main.astro';
import '../styles/orbit.css';

import HowWeWork from '../components/sections/HowWeWork.astro';
import Documents from '../components/sections/Documents.astro';
import Banner from '../components/sections/Banner.astro';
import Statistic from '../components/Statistic.astro';
import Trasted from '../components/sections/Trasted.astro';
import Cases from '../components/sections/Cases.astro';
import Achivments from '../components/sections/Achivments.astro';
import Calculator from '../components/sections/Calculator';
import Services from '../components/sections/Services.astro';
import WorldTransfers from '../components/sections/WorldTransfers.astro';
import Faq from '../components/sections/Faq.astro';
import Request from '../components/sections/Request';

import statCommission from '../assets/img/stat-1.webp';
import statTerms from '../assets/img/stat-2.webp';
import statGeography from '../assets/img/stat-3.webp';

const statistics = [
  { label: 'Комиссия', value: '0,6%', image: statCommission },
  { label: 'Сроки', value: '1 день', image: statTerms },
  { label: 'География', value: '26 стран', image: statGeography },
];
---

<MainLayout
  title="R3Limited — Платёж в любую точку мира с комиссией 0,6%"
  description="Международные платежи R3Limited"
  page="index"
>
  <>
    <Banner />
    <Statistic statistics={statistics} ariaLabel="Преимущества R3 Limited" />
    <Trasted />
    <Calculator client:visible />
    <Services />
    <Cases />
    <Achivments />
    <HowWeWork />
    <Documents />
    <WorldTransfers />
    <Faq />
    <Request client:visible />
  </>
</MainLayout>
