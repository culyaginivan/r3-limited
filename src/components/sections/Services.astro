---
import { Icon } from 'astro-icon/components';

const services = [
  {
    title: 'Международные платежи',
    description: 'Проводим зарубежные переводы в разные страны и валюты.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
  {
    title: 'Быстрая оплата иностранных партнёров',
    description: 'Закрываем срочные счета и обеспечиваем быстрый проход платежей.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
  {
    title: 'Мультивалютные операции',
    description: 'Работаем с USD, EUR, CNY, AED и другими валютами.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
  {
    title: 'Проверка контрагентов',
    description: 'Технологическая проверка на благонадёжность и корректность реквизитов.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
  {
    title: 'Отчётность',
    description: 'Предоставляем полный комплект документов и подтверждений по каждому платежу.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
  {
    title: 'Консультация',
    description:
      'Предоставляем профессиональную консультацию и предлагаем наиболее выгодные условия.',
    details: {
        term: { value: '30–60 минут', iso8601: 'PT30M/PT1H' },
        commission: '0,3%',
    },
  },
];
---

<section id="services" class="services-section reveal-box" aria-labelledby="services-title">
  <header class="services-section__heading">
    <h2 id="services-title" class="h2">Наши услуги</h2>
    <a class="btn btn--lg btn--primary" href="#request">Оставить заявку</a>
  </header>

  <ol class="service-list" aria-label="Услуги R3 Limited">
    {
      services.map((service, index) => (
        <li>
          <article class="service-card">
            <div class="service-card__topline">
              <Icon name="service" class="service-card__icon" aria-hidden="true" />
              <span aria-hidden="true">{index.toString().padStart(2, '0')}</span>
            </div>

            <h3 class="h3 service-card__title">{service.title}</h3>
            <p class="service-card__description">{service.description}</p>

            <dl class="service-card__details">
              <div>
                <dt>Срок</dt>
                <dd>
                    <time datetime={service.details.term.iso8601}>
                        {service.details.term.value}
                    </time>
                </dd>
              </div>
              <div>
                <dt>Комиссия</dt>
                <dd>{service.details.commission}</dd>
              </div>
            </dl>
          </article>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .services-section {
    display: flex;
    flex-direction: column;
    gap: 64px;
    width: 100%;
    margin-block: 88px;
    padding-inline: var(--gutter);
  }

  .services-section__heading {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .services-section h2 {
    flex: 1;
    font-size: 48px;
    font-weight: 600;
    line-height: 56px;
  }

  .service-list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .service-list li {
    width: calc((100% - 32px)/3);
  }

  .service-card {
    display: flex;
    height: 100%;
    width: 100%;
    flex-direction: column;
    padding: 40px;
    border-radius: var(--r-2xl);
    background: var(--secondary-60);
  }

  .service-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .service-card__icon {
    width: 32px;
    height: 32px;
  }

  .service-card__topline span {
    font-size: 16px;
    line-height: 24px;
  }

  .service-card__description {
    padding-block-end: 24px;
  }

  .service-card h3 {
    color: var(--primary-100);
    padding-block-start: 40px;
    padding-block-end: 16px;
  }

  .service-card p,
  .service-card__details {
    font-size: 16px;
    line-height: 24px;
  }

  .service-card__details {
    display: flex;
    gap: 16px;
    margin-top: auto;
    border-top: 2px solid var(--secondary-80);
    padding-block-start: 24px;
  }

  .service-card__details > div {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 8px;
  }

  .service-card__details dd {
    font-weight: 600;
  }

  @media (max-width: 1200px) {
    .services-section {
      margin-block: 64px;
    }

    .service-card {
      padding: 24px;
    }
  }

  @media (max-width: 992px) {
    .services-section {
      gap: 40px;
      overflow-y: auto;
    }
    
    .services-section__heading {
      position: sticky;
      left: 0;
    }

    .service-list {
        flex-wrap: nowrap;
    }
    .service-list li {
        min-width: 330px;
    }
  }

  @media (max-width: 786px) {
    .services-section__heading .btn {
      height: 44px;
      padding: 12px 16px;
      font-size: 14px;
    }

    .services-section h2 {
        font-size: 32px;
        line-height: 40px;
    }
  }

  @media (max-width: 480px) {
    .services-section {
        gap: 32px;
        margin-block: 40px;
        padding-inline: 16px;
    }

    .services-section h2 {
        font-size: 28px;
        line-height: 36px;
    }

    .service-card p,
    .service-card__details {
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>
