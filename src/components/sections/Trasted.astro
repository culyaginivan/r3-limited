---
import { Image } from "astro:assets";
import logoPSB from "../../assets/img/logo-psb.webp";
import logoTBank from "../../assets/img/logo-tbank.webp";
import logoAlfa from "../../assets/img/logo-alfa.webp";
import logoTochka from "../../assets/img/logo-tochka.webp";

const partners = [
    {
        logo: logoPSB,
        label: 'ПСБ банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoTBank,
        label: 'T банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoAlfa,
        label: 'Альфа банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoTochka,
        label: 'Точка банк',
        width: 103,
        height: 30,
    },    
];

---

<section class="
    reveal-box flex w-full flex-col-2 items-center overflow-hidden 
    px-(--gutter) py-11 max-lg:py-8 max-md:py-6
    max-md:flex-col max-md:items-start max-md:gap-10 max-sm:gap-6
">
    <h2 class="text-xl/6 w-[196px] my-6 max-md:my-[0px] max-md:w-fit pr-6 max-md:py-3 border-r border-[var(--secondary-70)] max-md:border-r-0">
        Нам доверяют банки и партнеры
    </h2>

    <div class="trasted-wrapper relative min-w-0 flex-1 overflow-hidden pl-16 max-md:pl-[0px]">
        <ul class="marquee-track flex w-max items-center" aria-label="Банки и партнеры">
            {Array.from({ length: 3 }).map((_, groupIndex) => (
                <li class="marquee-group" aria-hidden={groupIndex > 0}>
                    {partners.map(item => (
                        <Image
                            width={item.width}
                            src={item.logo} 
                            alt={groupIndex === 0 ? item.label : ""} 
                        />
                    ))}
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .marquee-track {
        display: flex;
        width: max-content;
        align-items: center;
    }

    .marquee-group {
        display: flex;
        align-items: center;
        gap: 4rem;
        padding-right: 4rem;
        will-change: transform;
        animation: trusted-marquee 20s linear infinite;
    }

    .marquee-track:hover .marquee-group,
    .marquee-track:focus-within .marquee-group {
        animation-play-state: paused;
    }

    @keyframes trusted-marquee {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-100%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-group {
            animation: none;
        }
    }
</style>
