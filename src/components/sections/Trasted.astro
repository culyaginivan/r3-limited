---
import { Image } from "astro:assets";
import logoPSB from "../../assets/img/logo-psb.webp";
import logoTBank from "../../assets/img/logo-tbank.webp";
import logoAlfa from "../../assets/img/logo-alfa.webp";
import logoTochka from "../../assets/img/logo-tochka.webp";

const partners = [
    {
        logo: logoPSB,
        label: 'ПСБ банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoTBank,
        label: 'T банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoAlfa,
        label: 'Альфа банк',
        width: 103,
        height: 30,
    },
    {
        logo: logoTochka,
        label: 'Точка банк',
        width: 103,
        height: 30,
    },    
];

---

<section class="reveal-box flex w-full flex-col items-start gap-8 overflow-hidden px-4 py-8 sm:px-8 sm:py-11 lg:flex-row lg:items-center lg:gap-16 lg:px-16">
    <h2 class="shrink-0 text-xl font-normal leading-6 text-[var(--primary-100)] lg:w-[172px]">
        Нам доверяют<br />банки и партнеры
    </h2>

    <div class="relative min-w-0 flex-1 overflow-hidden border-t border-[var(--secondary-70)] pt-8 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0">
        <ul class="marquee-track flex w-max items-center gap-16" aria-label="Банки и партнеры">
            {Array.from({ length: 2 }).map((_, groupIndex) => (
                <li class="flex items-center gap-16" aria-hidden={groupIndex > 0}>
                    {partners.map(item => (
                        <span class={`flex h-8 w-[${item.width}px] shrink-0 items-center justify-center`}>
                            <Image class={`max-h-full w-auto object-contain aspect-[${item.width}/${item.height}]`} width={item.width} height={item.height} src={item.logo} alt={groupIndex === 0 ? item.label : ""} />
                        </span>
                    ))}
                </li>
            ))}
        </ul>
    </div>
</section>

<style>
    .marquee-track {
        animation: trusted-marquee 24s linear infinite;
    }

    .marquee-track:hover,
    .marquee-track:focus-within {
        animation-play-state: paused;
    }

    @keyframes trusted-marquee {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(calc(-50% - 2rem));
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-track {
            animation-play-state: paused;
        }
    }
</style>
