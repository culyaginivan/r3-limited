---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import worldMap from '../../assets/img/map-optimized.svg';

interface Country {
  id: string;
  name: string;
  flag: string;
  currency: string;
  comission: string;
  timeText: string;
  isoTime: string;
  coords: { x: number; y: number };
}

const countries: Country[] = [
  {
    id: 'china',
    name: 'Китай',
    flag: 'china',
    currency: 'CNY',
    comission: '0,6%',
    timeText: '1 день',
    isoTime: 'P1D',
    coords: { x: 1425, y: 440 },
  },
  {
    id: 'usa',
    name: 'США',
    flag: 'usa',
    currency: 'USD',
    comission: '0,9%',
    timeText: '1 день',
    isoTime: 'P1D',
    coords: { x: 300, y: 390 },
  },
  {
    id: 'uae',
    name: 'ОАЭ',
    flag: 'uae',
    currency: 'AED',
    comission: '0,9%',
    timeText: '1 день',
    isoTime: 'P1D',
    coords: { x: 1185, y: 513 },
  },
  {
    id: 'turkey',
    name: 'Турция',
    flag: 'turkey',
    currency: 'TRY',
    comission: '1,1%',
    timeText: '1 день',
    isoTime: 'P1D',
    coords: { x: 1103, y: 417 },
  },
  {
    id: 'russia',
    name: 'Россия',
    flag: 'russia',
    currency: 'RUB',
    comission: '0,7%',
    timeText: '1 день',
    isoTime: 'P1D',
    coords: { x: 1281, y: 222 },
  },
];

const defaultActiveId = countries[0].id;
---

<section id="geo" class="world-transfers reveal-box max-lg:world-transfers.gap-10" aria-labelledby="transfers-title">
  <h2 id="transfers-title" class="h2">Переводы по всему миру</h2>

  <div class="world-transfers__card">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1916"
      height="1123"
      viewBox="0 0 1916 1123"
      fill="none"
      aria-hidden="true"
    >
      <foreignObject x="0" y="0" width="1916" height="1123">
        <Image
          src={worldMap}
          alt="Карта подложка"
          loading="lazy"
          width="1916" 
          height="1123"
          densities={[1, 1.5, 2]}
          format="svg"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </foreignObject>

      {
        countries.map((marker) => (
          <g
            class={`marker ${marker.id === defaultActiveId ? 'active' : ''}`}
            id={'marker-' + marker.id}
            data-country-id={marker.id}
            data-x={marker.coords.x}
            data-y={marker.coords.y}
            transform={`translate(${marker.coords.x}, ${marker.coords.y})`}
          >
            <g class="marker-content">
              <circle cx="20" cy="20" r="22" class="marker-outline" />
              <foreignObject width="40" height="40">
                <Icon name={`flags/${marker.flag}`} style="width: 100%; height: 100%;" />
              </foreignObject>
            </g>
          </g>
        ))
      }
    </svg>
  </div>
  <aside class="country-widget">
    <h3 class="sr-only">Условия переводов по странам</h3>
    <div class="country-widget__list" role="radiogroup" aria-label="Выберите страну">
      {
        countries.map((country) => {
          const isActive = country.id === defaultActiveId;
          return (
            <div class="country-widget__item">
              <button
                type="button"
                class:list={['country-widget__option', { active: isActive }]}
                role="radio"
                aria-checked={isActive ? 'true' : 'false'}
                data-country-id={country.id}
              >
                <span class="country-widget__info">
                  <Icon
                    name={'flags/' + country.flag}
                    class="country-widget__flag"
                    aria-hidden="true"
                  />
                  <span class="country-widget__name">{country.name}</span>
                </span>

                <dl class="country-widget__metrics">
                  <dt class="sr-only">Валюта:</dt>
                  <dd class="country-widget__currency">{country.currency}</dd>

                  <dt class="sr-only">Комиссия:</dt>
                  <dd class="country-widget__fee">{country.comission}</dd>

                  <dt class="sr-only">Срок перевода:</dt>
                  <dd class="transfer-time">
                    <time datetime={country.isoTime} class="country-widget__time">
                      {country.timeText}
                    </time>
                  </dd>
                </dl>
              </button>
            </div>
          );
        })
      }
    </div>

    <footer>
      <a href="#calculator" class="inline-block text-center country-widget__cta-btn">Уточнить условия</a>
    </footer>
  </aside>
</section>

<script>
  function initMapWidget() {
    const viewport = document.querySelector<HTMLDivElement>('.world-transfers__card');
    const widget = document.querySelector<HTMLDivElement>('.country-widget');
    const pins = document.querySelectorAll<SVGGElement>('.marker');
    const options = document.querySelectorAll<HTMLButtonElement>('.country-widget__option');

    [...pins, ...options].forEach((el) => {
      const countryId = el.dataset.countryId;
      if (countryId) {
        el.addEventListener('click', () => {
          let activePin: SVGGElement | undefined;
          [...pins, ...options].forEach((el) => {
            const isActive = el.dataset.countryId === countryId;
            el.classList.toggle('active', isActive);

            if (el instanceof HTMLButtonElement) {
              el.setAttribute('aria-checked', isActive ? 'true' : 'false');
            } else if (isActive) {
              activePin = el;
            }
          });

          if (activePin && window.outerWidth > 480) {
            focusOnPin(activePin);
          }
        });
      }
    });

    function focusOnPin(pin: SVGGElement) {
      if (!viewport) return;
      const widgetWidth = window.outerWidth > 768 && widget?.clientWidth ? widget?.clientWidth : 0;
      const viewCenterX = (viewport.clientWidth - widgetWidth) / 2;
      const viewCenterY = viewport.clientHeight / 2;
      const translateX = parseFloat(pin.dataset.x!);
      const translateY = parseFloat(pin.dataset.y!);

      viewport
        .querySelector('svg')
        ?.style.setProperty(
          'transform',
          `translate3d(${viewCenterX - translateX}px, ${viewCenterY - translateY}px, 0)`,
        );
    }
  }

  document.addEventListener('astro:page-load', initMapWidget);
</script>

<style>
  .world-transfers {
    display: flex;
    flex-direction: column;
    padding-inline: var(--gutter);
    padding-block-end: 88px;
    gap: 64px;
  }

  .world-transfers__card {
    position: relative;
    height: 740px;
    background-color: #f4f6fa;
    border-radius: 24px;
    overflow: hidden;
  }

  .world-transfers__card > svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 1916px;
    height: 1123px;
    /* TODO: Разобраться с масштабом на разных устройствах
     *  
     * width: 114.6%;
     * height: auto;
     * aspect-ratio: 1916 / 1123; 
     */
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    transform: translate3d(-39.2%, -11.8%, 0);
  }

  .marker {
    cursor: pointer;
  }

  .marker-content {
    transition: transform 0.2s ease-in-out;
    transform-origin: 20px 20px;
    animation: pulse;
  }

  .marker.active .marker-content,
  .marker:hover .marker-content {
    transform: scale(1.2);
  }

  .marker-outline {
    transition: stroke 0.2s;
  }

  .marker.active .marker-outline,
  .marker:hover .marker-outline {
    stroke: var(--primary-90);
    stroke-width: 3;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70% {
      transform: scale(2.2);
      opacity: 0;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .country-widget {
    position: absolute;
    bottom: calc(40px + 88px);
    right: calc(40px + var(--gutter));
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: calc(740px - 80px);
    padding: 32px;
    width: 443px;
    border-radius: 24px;
    background: var(--neutral-10);
    box-shadow: 16px 16px 32px 0 rgba(21, 23, 34, 0.15);
    z-index: 2;
  }

  .country-widget__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .country-widget__item {
    padding-block: 16px;
  }
  .country-widget__item:first-child {
    padding-block-start: 0;
  }
  .country-widget__item:not(:last-child) {
    border-bottom: 1px solid #e9ebf3;
  }

  .country-widget__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 8px 16px 8px 8px;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: 16px;
    line-height: 24px;
    border-radius: 40px;
    transition: background-color 0.2s ease;
  }

  .country-widget__option.active,
  .country-widget__option:hover {
    background-color: var(--secondary-80);
  }

  .country-widget__info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: #0a0c19;
  }

  .country-widget__flag {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .country-widget__metrics {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #0a0c19;
    font-size: 16px;
    line-height: 24px;
  }

  .country-widget__currency {
    width: 40px;
    font-weight: 400;
    color: inherit;
  }

  .country-widget__fee {
    width: 40px;
  }

  .country-widget__time {
    width: 56px;
  }

  footer {
    margin-top: auto;
  }
  .country-widget__cta-btn {
    width: 100%;
    min-height: 56px;
    padding: 16px 32px;
    background-color: #282dad;
    color: #ffffff;
    border: none;
    border-radius: 32px;
    font-family: inherit;
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .country-widget__cta-btn:hover {
    background-color: #20258f;
  }

  @media (max-width: 1440px) {
    .world-transfers__card > svg {
      transform: translate3d(-48.2%, -11.8%, 0);
    }
  }
  @media (max-width: 1200px) {
    .world-transfers__card > svg {
      transform: translate3d(-53%, -2%, 0);
    }
  }
  @media (max-width: 786px) {
    .world-transfers {
      padding-bottom: 506px;
      padding-inline: 0;
    }
    .world-transfers h2 {
      padding-inline: var(--gutter);
    }
    .world-transfers__card {
      height: 400px;
      border-radius: var(--r-xl);
    }
    .world-transfers__card > svg {
      transform: translate3d(-53%, -18%, 0);
    }
    .country-widget {
      left: 0;
      bottom: 0;
      height: 506px;
      width: 100%;
      box-shadow: none;
      border-radius: var(--r-lg);
    }
  }

  @media (max-width: 480px) {
    .world-transfers__card > svg {
      width: 587.159px;
      height: 344.441px;
      transform: translate3d(-16%, 8%, 0);
    }
    .country-widget {
      padding-block: 32px 0;
      padding-inline: 16px;
    }
  }
</style>
