---
import { Image } from "astro:assets";

export interface Statistic {
    label: string;
    value: string;
    image: ImageMetadata;
}

interface Props {
    statistics: Statistic[];
    ariaLabel: string;
}

const {
    statistics,
    ariaLabel, 
} = Astro.props;

---

<aside class="statistic reveal-box flex w-full flex-col items-start py-[44px] px-[var(--gutter)] max-lg:px-8">
	<h2 class="sr-only">{ariaLabel}</h2>
    <ul class="grid w-full gap-4 grid-cols-3 max-md:grid-cols-2 max-sm:grid-cols-1">
		{statistics.map((statistic, i) => (
			<li class:list={[
                "statistic__card relative flex min-w-0 flex-col items-start gap-4 overflow-hidden rounded-[var(--r-2xl)] bg-[var(--secondary-60)] px-10 py-8 max-lg:p-6",
                i === statistics.length - 1 ? 'max-md:col-span-2 max-sm:col-span-1' : '',
            ]}>
				<h3 class="statistic__label min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">
					{statistic.label}
				</h3>
				<p class="h2 statistic__value min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">
					{statistic.value}
				</p>
				<Image
                    class="statistic__img"
					src={statistic.image}
                    height={80}
                    width={80}
					alt=""
					class="pointer-events-none absolute right-5 top-5 size-20 max-lg:size-16 object-cover"
				/>
			</li>
		))}
	</ul>
</aside>

<style>
	.statistic__label {
        font-size: 20px;
        line-height: 24px;
	}

    .statistic__value {
        z-index: 1;
    }

	@media (max-width: 1200px) {
        .statistic__label {
            font-size: 16px;
        }
	}
</style>
