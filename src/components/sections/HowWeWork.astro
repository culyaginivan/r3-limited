---
import { Icon } from "astro-icon/components";

const steps = [
  {
	name: 'Заявка',
	desc: 'Подайте запрос и менеджер свяжется с вами',
	duration: {
		value: '30–60 минут',
		iso8601: 'PT30M/PT1H',
	}
  },
  {
	name: 'Проверка',
	desc: 'Автоматизированная проверка документов и уточнение деталей.',
	duration: {
		value: '30 минут',
		iso8601: 'PT30M',
	}
  },
  {
	name: 'Платёж',
	desc: 'Проводим операцию в течение рабочего дня.',
	duration: {
		value: '3-4 часа',
		iso8601: 'PT3H/PT4H',
	}
  },
  {
	name: 'Подтверждение',
	desc: 'Выдаём PDF-подтверждение о выполнении платежа.',
	duration: {
		value: '30–60 минут',
		iso8601: 'PT30M/PT1H',
	}
  },
  {
	name: 'Отчётность',
	desc: 'Предоставляем акт и полный комплект документов.',
	duration: {
		value: '10–20 минут',
		iso8601: 'PT10M/PT20M',
	}
  },
];

---

<section id="how-we-work" class="reveal-box mx-auto flex w-full max-w-[var(--canvas)] flex-col gap-10 rounded-[var(--r-2xl)] bg-[image:var(--gradient-2)] gap-16 px-16 py-[88px] max-xl:px-[40px] max-xl:py-[64px] max-md:px-8 max-sm:px-4 max-sm:py-16">
	<h2 class="h2">Как мы работаем</h2>

	<ol class="steps flex gap-6 pb-10 overflow-auto">
		{steps.map((step, index) => (
			<li class="group flex min-w-0 flex-col gap-5 min-w-[160px]" data-active={index === 0 ? 'true' : null}>
				<div class="flex items-center gap-4" aria-hidden="true">
					<span class="size-4 shrink-0 rounded-full bg-[var(--primary-100)] group-data-[active]:bg-[var(--primary-90)]"></span>
					<span class="h-0 min-w-0 flex-1 border-t border-[var(--neutral-70)] group-data-[active]:border-[var(--primary-90)]"></span>
				</div>

				<div class="flex min-h-0 flex-1 flex-col gap-5">
					<h3 class="h3 break-all">{step.name}</h3>
					<p class="min-h-0 flex-1 text-xs leading-4 lg:text-base lg:leading-6">{step.desc}</p>
					<div class="flex items-center gap-2 border-t border-[var(--secondary-90)] pt-3">
						<Icon name="clock" class="size-6 shrink-0" aria-hidden="true" />
						<time datetime={step.duration.iso8601} class="text-xs font-semibold leading-4 lg:text-base lg:leading-6">{step.duration.value}</time>
					</div>
					{index === 0 && (
						<a href="#request" class="btn btn--md btn--primary w-full">
							Оставить заявку
						</a>
					)}
				</div>
			</li>
		))}
	</ol>
</section>
