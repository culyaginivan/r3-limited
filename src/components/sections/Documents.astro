---
import { Image } from "astro:assets";

import doc1Image from "../../assets/img/doc-1.webp";
import doc2Image from "../../assets/img/doc-2.webp";
import doc3Image from "../../assets/img/doc-3.webp";
import doc4Image from "../../assets/img/doc-4.webp";
import { Icon } from "astro-icon/components";
import { company } from "../../data/company";

const documents = [
    {
        title: "Юридическое лицо",
        file: "выписка",
        type: "PDF",
        size: "000 КБ",
        image: doc1Image,
    },
    {
        title: "Договор",
        file: "образец",
        type: "PDF",
        size: "000 КБ",
        image: doc2Image,
    },
    {
        title: "AML / KYC",
        file: "политика",
        type: "PDF",
        size: "000 КБ",
        image: doc3Image,
    },
    {
        title: "Политика конфиденциальности",
        file: "документ",
        type: "PDF",
        size: "000 КБ",
        image: doc4Image,
    },
];
---

<section id="documents" data-reveal class="mx-auto flex w-full max-w-[var(--canvas)] flex-col gap-10 px-4 py-16 text-[var(--primary-100)] sm:px-8 lg:gap-16 lg:px-16 lg:py-[88px]">
    <h2 class="h2">
        Доверие и документы
    </h2>

    <div class="grid gap-4 lg:grid-cols-[minmax(320px,418px)_minmax(0,1fr)]">
        <aside class="flex flex-col gap-8 rounded-[var(--r-2xl)] bg-[image:var(--gradient-2)] p-6 sm:p-8 lg:gap-10 lg:p-10" aria-labelledby="details-title">
            <h3 id="details-title" class="text-xl font-semibold leading-6 lg:text-2xl lg:leading-7">Реквизиты</h3>

            <dl class="flex flex-col gap-5 text-xs leading-4 lg:gap-6 lg:text-base lg:leading-6">
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-70)] pb-4 lg:pb-5">
                    <dt>Наименование</dt>
                    <dd class="text-right font-semibold">{company.name}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-70)] pb-4 lg:pb-5">
                    <dt>Регистрационный №</dt>
                    <dd class="text-right font-semibold">{company.registrationNumber}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-70)] pb-4 lg:pb-5">
                    <dt>ИНН</dt>
                    <dd class="text-right font-semibold">{company.taxId}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-70)] pb-4 lg:pb-5">
                    <dt>КПП</dt>
                    <dd class="text-right font-semibold">{company.kpp}</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="max-w-[120px]">Юридический адрес</dt>
                    <dd class="max-w-[200px] text-right font-semibold uppercase">{company.legalAddress}</dd>
                </div>
            </dl>
        </aside>

        <div class="grid gap-4 sm:grid-cols-2">
            {documents.map((document) => (
                <article class="relative flex min-h-[240px] flex-col overflow-hidden rounded-[var(--r-2xl)] bg-[var(--secondary-60)] p-6 sm:p-8 lg:min-h-[240px] lg:p-10">
                    <Image src={document.image} alt="" width={100} height={100} class="absolute bottom-5 right-5 h-[100px] w-[100px] object-contain" />
                    <div class="relative flex h-full max-w-[280px] flex-col gap-5 lg:gap-6">
                        <h3 class="text-xl font-semibold leading-6 lg:text-2xl lg:leading-7">{document.title}</h3>
                        <div class="flex flex-col items-start gap-1 text-xs leading-4 lg:text-base lg:leading-6">
                            <p>[{document.file} · {document.type} · {document.size}]</p>
                            <button type="button" class="flex items-center gap-2 font-semibold" aria-label={`Скачать: ${document.title}`}>
                                <span>Скачать</span>
                                <Icon name="download" class="h-6 w-6" aria-hidden="true" />
                            </button>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>

