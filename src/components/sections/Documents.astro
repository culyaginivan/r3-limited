---
import { Image } from "astro:assets";

import doc1Image from "../../assets/img/doc-1.webp";
import doc2Image from "../../assets/img/doc-2.webp";
import doc3Image from "../../assets/img/doc-3.webp";
import doc4Image from "../../assets/img/doc-4.webp";
import { Icon } from "astro-icon/components";
import { company } from "../../data/company";

const documents = [
    {
        title: "Юридическое лицо",
        file: "выписка",
        type: "PDF",
        size: "000 КБ",
        image: doc1Image,
    },
    {
        title: "Договор",
        file: "образец",
        type: "PDF",
        size: "000 КБ",
        image: doc2Image,
    },
    {
        title: "AML / KYC",
        file: "политика",
        type: "PDF",
        size: "000 КБ",
        image: doc3Image,
    },
    {
        title: "Политика конфиденциальности",
        file: "документ",
        type: "PDF",
        size: "000 КБ",
        image: doc4Image,
    },
];
---

<section id="documents" class="reveal-box mx-auto flex w-full max-w-[var(--canvas)] flex-col gap-10 px-4 py-16 sm:px-8 lg:gap-16 lg:px-16 lg:py-[88px]">
    <h2 class="h2">
        Доверие и документы
    </h2>

    <div class="
        grid gap-4 grid-cols-[minmax(320px,420px)_minmax(0,1fr)] 
        max-xl:grid-cols-[minmax(320px,320px)_minmax(0,1fr)]
        max-lg:grid-cols-1 max-md:overflow-auto
    ">
        <aside
            class="
                flex flex-col rounded-[var(--r-2xl)] max-lg:rounded-[var(--r-lg)] 
                bg-[image:var(--gradient-2)] gap-10 p-10 max-xl:p-6
                max-md:sticky max-md:left-0 
            " 
            aria-labelledby="details-title"
        >
            <h3 id="details-title" class="text-xl font-semibold leading-6 lg:text-2xl lg:leading-7">Реквизиты</h3>

            <dl class="flex flex-col gap-5 text-xs leading-4 lg:gap-6 lg:text-base lg:leading-6">
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-80)] pb-4 lg:pb-5">
                    <dt>Наименование</dt>
                    <dd class="text-right font-semibold">{company.name}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-80)] pb-4 lg:pb-5">
                    <dt>Регистрационный №</dt>
                    <dd class="text-right font-semibold">{company.registrationNumber}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-80)] pb-4 lg:pb-5">
                    <dt>ИНН</dt>
                    <dd class="text-right font-semibold">{company.taxId}</dd>
                </div>
                <div class="flex items-center justify-between gap-4 border-b border-[var(--secondary-80)] pb-4 lg:pb-5">
                    <dt>КПП</dt>
                    <dd class="text-right font-semibold">{company.kpp}</dd>
                </div>
                <div class="flex items-start justify-between gap-4">
                    <dt class="max-w-[120px]">Юридический адрес</dt>
                    <dd class="max-w-[200px] text-right font-semibold uppercase">{company.legalAddress}</dd>
                </div>
            </dl>
        </aside>

        <ul class="grid gap-4 grid-cols-2 max-lg:grid-cols-2 max-md:grid-cols-4 max-md:w-[max-content]">
            {documents.map((document) => (
                <li>
                    <article class="
                        relative flex flex-col overflow-hidden h-full gap-4
                        rounded-[var(--r-2xl)] max-lg:rounded-[var(--r-lg)] 
                        bg-[var(--secondary-60)] p-10 max-xl:p-6 max-md:p-6
                        max-md:w-[340px]
                    "> 
                        <Image 
                            src={document.image} 
                            alt="" 
                            width={100} 
                            height={100} 
                            class="
                                absolute bottom-5 right-5
                                max-xl:relative max-xl:bottom-[unset] max-xl:right-[unset]
                                h-[100px] w-[100px] object-contain
                                max-md:absolute max-md:bottom-5 max-md:right-5 
                                max-md:w-20 max-md:h-20
                            " 
                        />
                        <div class="relative flex h-full max-w-[280px] flex-col gap-6 max-md:justify-between">
                            <h3 class="text-xl font-semibold leading-6 lg:text-2xl lg:leading-7">{document.title}</h3>
                            <div class="flex flex-col items-start gap-1 text-xs leading-4 lg:text-base lg:leading-6">
                                <p>[{document.file} · {document.type} · {document.size}]</p>
                                <button type="button" class="flex items-center gap-2 font-semibold" aria-label={`Скачать: ${document.title}`}>
                                    <span>Скачать</span>
                                    <Icon name="download" class="h-6 w-6" aria-hidden="true" />
                                </button>
                            </div>
                        </div>
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>

