---
const achivments = [
    { label: "Клиентов", stringValue: "10 000+", value: 10000 },
    { label: "Операций", stringValue: "50 000+", value: 50000 },
    { label: "Кейсов", stringValue: "200+", value: 200 },
    { label: "Стран", stringValue: "26", value: 26 },
];
---

<aside
    class="reveal-box w-full px-16 py-14 max-xl:px-10 max-xl:py-12 max-lg:px-6 max-md:px-[0px]"    
    aria-labelledby="achievements-title"
>
    <h2 id="achievements-title" class="sr-only">Наши достижения</h2>
    <ul class="achievement-list flex w-full flex-wrap content-start items-start justify-center gap-x-20 gap-y-6 max-lg:gap-x-8 max-md:gap-x-6">
        {
            achivments.map((item) => (
                <li class="flex w-fit min-w-50 max-lg:min-w-40 flex-col items-center gap-4">
                    <h3 data-target={item.value} class="order-first text-center font-semibold text-5xl/[1.2] max-lg:text-[32px]/8">
                        {item.stringValue}
                    </h3>
                    <p class="text-center text-xl/6">{item.label}</p>
                </li>
            ))
        }
    </ul>
</aside>

<script>
 function initAchivments() {
    const elements = document.querySelectorAll<HTMLDivElement>('.order-first');
    const block = document.querySelector('.achievement-list');
    if (!elements.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const DURATION = 1600;
    const formatter = new Intl.NumberFormat('ru-RU'); 

    const animate = () => {
      const start = performance.now();
      
      elements.forEach(el => el.style.minWidth = `${el.offsetWidth}px`);

      const step = (now: number) => {
        const progress = Math.min((now - start) / DURATION, 1);
        const eased = 1 - Math.pow(1 - progress, 3);

        elements.forEach(el => {
          const target = +el.dataset.target!;
          if (!target) return;
          
          const current = Math.round(target * eased);
          el.textContent = formatter.format(current) + (el.textContent.includes('+') ? '+' : '');
        });

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          elements.forEach(el => el.style.minWidth = '');
        }
      };
      requestAnimationFrame(step);
    };

    if (block) {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          io.disconnect();
          animate();
        }
      }, { rootMargin: '0px 0px -20% 0px' });
      io.observe(block);
    }
  }

  document.addEventListener('DOMContentLoaded', initAchivments);
</script>
