---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import caseOneImage from "../../assets/img/case-1.webp";
import caseTwoImage from "../../assets/img/case-2.webp";
import caseThreeImage from "../../assets/img/case-3.webp";
import caseFourImage from "../../assets/img/case-4.webp";

const cases = [
    {
        location: "США / Мексика / Канада",
        duration: "10 часов",
        title: "Оплата VIP-лож FIFA через проверенного плательщика",
        image: caseOneImage,
        results: [
            "<strong>Билеты на футбольный праздник — уже на следующий день.</strong><br> Клиент получил их на электронную почту.",
            "Сэкономили деньги и снизили финансовые риски. При неуспешной оплате могли возникнуть штрафные санкции или отмена бронирования.",
            "<strong>Оформили сделку по официальному ВЭД-контракту.</strong><br> Туроператор официально перечислил денежные средства на наш счёт.",
        ],
        href: "/cases/vip/",
    },
    {
        location: "ОАЭ",
        duration: "10 часов",
        title: "Срочная оплата рентгеновского оборудования в ОАЭ",
        image: caseTwoImage,
        results: [
            "Оплата в течение нескольких часов поступила на счёт клиента.",
            "Заказ оперативно отгрузили и передали в обработку логистической службе.",
            "Провели оплату в соответствии со всеми требованиями законодательства РФ и предоставили полный комплект закрывающих документов.",
        ],
        href: "#request",
    },
    {
        location: "Китай (Гонконг)",
        duration: "6 часов",
        title: "Оплата серверного оборудования в обход банковских ограничений",
        image: caseThreeImage,
        results: [
            "Через 6 часов после начала процесса поставщик подтвердил поступление средств.",
            "Оборудование было зарезервировано и отправлено логистическим партнёрам в тот же день.",
            "Клиент получил полный комплект закрывающих документов: инвойсы, платёжные поручения и акты сверки.",
            "Сроки поставки сохранены — оборудование уже в пути к клиенту.",
        ],
        href: "#request",
    },
    {
        location: "Великобритания",
        duration: "14 часов",
        title: "Оплата чартерного рейса в Великобритании за 14 часов",
        image: caseFourImage,
        results: [
            "Через 14 часов британский оператор подтвердил поступление средств в полном объёме.",
            "Рейс выполнен по расписанию — все аэропортовые службы получили оплату вовремя.",
            "Клиент получил полный комплект закрывающих документов по операции.",
        ],
        href: "#request",
    },
];
---

<section id="cases" data-reveal class="cases-section">
    <h2 class="h2">Кейсы</h2>

    <ul class="cases-list" aria-label="Истории успешных платежей">
        {cases.map((item) => (
            <li>
                <article class="case-card">
                    <Image
                        class="case-card__image" 
                        src={item.image} 
                        alt="" 
                        height={200}
                        aria-hidden="true" 
                    />

                    <header class="case-card__header">
                        <h3 class="h3">{item.title}</h3>

                        <p class="case-card__meta">
                            <span>{item.location}</span>
                            <span aria-hidden="true">•</span>
                            <time>{item.duration}</time>
                        </p>
                    </header>

                    <section class="case-card__results">
                        <h4>Результат</h4>
                        <ul>
                            {item.results.map((result) => (
                                <li>
                                    <Icon name="check" class="case-card__check" aria-hidden="true"/>
                                    <span set:html={result}></span>
                                </li>
                            ))}
                        </ul>
                    </section>

                    <footer class="case-card__footer">
                        <a class="btn btn--lg btn--secondary" href={item.href}>Открыть кейс</a>
                    </footer>
                </article>
            </li>
        ))}
    </ul>
</section>

<style>
    .cases-section {
        display: flex;
        flex-direction: column;
        gap: 64px;
        width: 100%;
        padding: 88px 64px;
        overflow: hidden;
        border-radius: var(--r-2xl);
        background: var(--gradient-cases);
    }

    .cases-section h2 {
        font-size: 48px;
        font-weight: 600;
        line-height: 56px;
    }

    .cases-list {
        display: flex;
        gap: 16px;
        width: max-content;
        align-items: stretch;
    }

    .case-card {
        display: flex;
        flex-direction: column;
        width: 600px;
        min-height: 100%;
        padding: 40px;
        overflow: hidden;
        border-radius: var(--r-2xl);
        background: var(--neutral-10);
    }

    .case-card__header {
        display: flex;
        flex-direction: column;
        padding-block-start: 40px;
    }

    .case-card__image {
        order: 0;
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: var(--r-lg);
    }

    .case-card h3 {
        font-size: 24px;
        padding-block: 24px;
        font-weight: 600;
        line-height: 28px;
        order: 2;
        border-bottom: 1px solid var(--secondary-80);
    }

    .case-card__meta {
        order: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        align-items: center;
        font-size: 16px;
        line-height: 24px;
    }

    .case-card__results {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-top: 24px;
        margin-bottom: 40px;
    }

    .case-card__results h4 {
        color: var(--success-100);
        font-size: 16px;
        font-weight: 600;
        line-height: 24px;
    }

    .case-card__results ul {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .case-card__results li {
        display: grid;
        grid-template-columns: 24px 1fr;
        gap: 10px;
        font-size: 16px;
        line-height: 24px;
    }

    .case-card__check {
        display: block;
        color: var(--success-100);
        font-size: 24px;
        margin-top: 2px;
    }

    .case-card__footer {
      margin-top: auto;
    }

    .case-card__footer a {
        height: 50px;
        width: 100%;
    }

    @media (max-width: 767px) {
        .cases-section {
            padding: 48px 16px;
            border-radius: var(--r-xl);
        }

        .cases-section h2 {
            font-size: 32px;
            line-height: 40px;
        }

        .cases-list {
            width: 100%;
            flex-direction: column;
        }

        .case-card {
            flex-basis: auto;
            min-height: 0;
            padding: 24px 16px;
            gap: 24px;
            border-radius: 20px;
        }

        .case-card__image {
            height: auto;
            aspect-ratio: 520 / 200;
            flex-basis: auto;
            border-radius: var(--r-md);
        }

        .case-card__meta,
        .case-card__results li,
        .case-card__link {
            font-size: 14px;
        }
    }
</style>