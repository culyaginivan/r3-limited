---
import { Font } from "astro:assets";
import IconSprite from "../components/form/IconSprite.astro";
import Header, { type currentPageIdType } from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Request from "../components/sections/Request";
import '../styles/global.css';
import Documents from "../components/sections/Documents.astro";
import Faq from "../components/sections/Faq.astro";
import HowWeWork from "../components/sections/HowWeWork.astro";
import WorldTransfers from "../components/sections/WorldTransfers.astro";
import SocialMeta from "../components/SocialMeta.astro";
import OrganizationSchema from "../components/schema/OrganizationSchema.astro";
import FinancialServiceSchema from "../components/schema/FinancialServiceSchema.astro";

interface Props {
    description: string;
    title: string;
	page: currentPageIdType;
}

const {
    description,
    title,
	page = 'index',
} = Astro.props;

---


<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}>
		<link rel="icon" type="image/png" sizes="120x120" href={`${import.meta.env.BASE_URL}favicon-120x120.png`}>
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`}>
		<link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`}>
		<link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`}>
		<Font cssVariable="--font-onest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
  		<title>{title}</title>
		<meta name="description" content={description} />
		<SocialMeta title={title} description={description} />
        <OrganizationSchema />
        {page === 'index' && <FinancialServiceSchema />}
        {Astro.slots.has('head') && (<slot name="head" />)}

        <!-- Yandex.Metrika counter -->
        <script type="text/javascript" is:inline>
            /* eslint-disable */
            (function(m,e,t,r,i,k,a){
                m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
                m[i].l=1*new Date();
                for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
                k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
            })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=113771383', 'ym');

            ym(113771383, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
            /* eslint-enable */
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/113771383" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
        <meta name="yandex-verification" content="abdbd8f20fd2ac2d" />
		<!-- /Yandex.Metrika counter -->
	</head>
	<body class="px-[60px] max-2xl:px-0">
		<Header current={page} />
		<main class="relative overflow-clip max-w-(--container-max) mx-auto mt-[-68px] max-sm:flex max-sm:flex-col max-sm:gap-10">
			<slot/>
			<HowWeWork />
			<Documents />
			{page === 'index' && <WorldTransfers />}
			<Faq />
			<Request client:idle />
			<Footer />
		</main>
		<IconSprite />

		<script>
			import { gsap } from "gsap";
  			import { ScrollTrigger } from "gsap/ScrollTrigger";

			const initScroll = () => {
				gsap.registerPlugin(ScrollTrigger);
				const revealBoxes = gsap.utils.toArray(".reveal-box") as HTMLElement[];
				revealBoxes.forEach((box) => {
					gsap.fromTo(box, 
						{
							opacity: 0,
							y: 60 
						}, 
						{
							opacity: 1,
							y: 0,
							duration: 1,
							ease: "power2.out",
							scrollTrigger: {
								trigger: box,
								start: "top 85%", // Анимация начнется, когда верх блока пересечет 85% экрана
								toggleActions: "play none none none", // Воспроизвести при скролле вниз, вернуть назад при скролле вверх
							}
						}
					);
				});
			};

			document.addEventListener("DOMContentLoaded", initScroll);
		</script>
    </body>
</html>