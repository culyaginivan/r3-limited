---
import { Font } from "astro:assets";
import IconSprite from "../components/form/IconSprite.astro";
import { ClientRouter } from "astro:transitions";
import Header, { type currentPageIdType } from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Request from "../components/sections/Request";
import '../styles/global.css';
import Documents from "../components/sections/Documents.astro";
import Faq from "../components/sections/Faq.astro";
import HowWeWork from "../components/sections/HowWeWork.astro";
import WorldTransfers from "../components/sections/WorldTransfers.astro";

interface Props {
    description: string;
    title: string;
	page: currentPageIdType;
}

const {
    description,
    title,
	page = 'index',
} = Astro.props;

---


<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`}>
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`}>
		<link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`}>
		<link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`}>
		<Font cssVariable="--font-onest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
  		<title>{title}</title>
		<meta name="description" content={description} />
        <!-- slot for additional head content -->
        {Astro.slots.has('head') && (<slot name="head" />)}
		<ClientRouter />
	</head>
	<body class="px-[60px] max-2xl:px-0">
		<IconSprite />
		<Header transition:persist current={page} />
		<main transition:animate="slide" class="relative overflow-clip max-w-(--container-max) mx-auto mt-[-68px] max-sm:flex max-sm:flex-col max-sm:gap-10">
			<slot/>
			<HowWeWork />
			<Documents />
			{page === 'index' && <WorldTransfers />}
			<Faq />
			<Request client:idle />
			<Footer transition:persist />
		</main>

		<script>
			import { gsap } from "gsap";
  			import { ScrollTrigger } from "gsap/ScrollTrigger";

			gsap.registerPlugin(ScrollTrigger);

			const initScroll = () => {
				const revealBoxes = gsap.utils.toArray(".reveal-box") as HTMLElement[];
				revealBoxes.forEach((box) => {
					gsap.fromTo(box, 
						{
							opacity: 0,
							y: 60 
						}, 
						{
							opacity: 1,
							y: 0,
							duration: 1,
							ease: "power2.out",
							scrollTrigger: {
								trigger: box,
								start: "top 85%", // Анимация начнется, когда верх блока пересечет 85% экрана
								toggleActions: "play none none reverse", // Воспроизвести при скролле вниз, вернуть назад при скролле вверх
							}
						}
					);
				});

				const wrapper = document.querySelector<HTMLElement>(".horizontals-wrapper")!;
				const horizontals = wrapper.querySelector<HTMLElement>(".horizontals")!;
				const width = wrapper.offsetWidth - horizontals.offsetLeft;

				function getScrollAmount() {
					return horizontals.scrollWidth - width;
				}

				const tween = gsap.to(horizontals, {
					x: () => -getScrollAmount(),
					ease: "none",
					paused: true
				});

				ScrollTrigger.create({
					trigger: wrapper,
					start: "top 20%",
					end: () => `+=${getScrollAmount()}`,
					pin: true,
					scrub: true,
					animation: tween,
					invalidateOnRefresh: true,
					markers: false
				});
			};

			document.addEventListener("astro:page-load", initScroll);
		</script>
    </body>
</html>